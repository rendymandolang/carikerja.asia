APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Asia/Singapore

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

HIRING_FIRST_RESPONSE_HOURS=72
HIRING_REMINDER_BEFORE_HOURS=24
HIRING_JOB_CONFIRMATION_DAYS=30
HIRING_ACTIVE_RESPONDER_DAYS=14
HIRING_ACTIVE_RESPONDER_RATE=80
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

OPERATIONS_BACKUP_PATH=backups
OPERATIONS_BACKUP_RETENTION_DAYS=7
OPERATIONS_SCHEDULER_STALE_MINUTES=5
OPERATIONS_BACKUP_STALE_HOURS=36

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Use "log" for local/testing. Use "smtp", "resend", "mailgun", or another configured mailer in production.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@carikerja.asia"
MAIL_FROM_NAME="Platform Carikerja"
MAIL_EHLO_DOMAIN=carikerja.asia
MAIL_SERVER_MODE=external
MAIL_DOMAIN=carikerja.asia
MAIL_HOSTNAME=mail.carikerja.asia
MAIL_DKIM_SELECTOR=default
MAIL_POSTMASTER=postmaster@carikerja.asia

SEO_SITE_NAME=carikerja.asia
SEO_TITLE="carikerja.asia - Hiring Lebih Jelas"
SEO_DESCRIPTION="carikerja.asia membantu kandidat memantau status lamaran dan recruiter mengelola hiring dengan lebih rapi, cepat, dan transparan."
SEO_KEYWORDS="lowongan kerja, cari kerja, job portal, ATS, recruiter, kandidat, Indonesia"
SEO_IMAGE=images/carikerja-logo.png
SEO_CONTACT_EMAIL=hello@carikerja.asia
LEGAL_PLATFORM_NAME=carikerja.asia
LEGAL_EFFECTIVE_DATE=2026-07-02

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/candidate/login/google/callback"
GOOGLE_WORKSPACE_REDIRECT_URI="${APP_URL}/recruiter/google-workspace/callback"
GOOGLE_CALENDAR_SEND_UPDATES=all

VITE_APP_NAME="${APP_NAME}"
